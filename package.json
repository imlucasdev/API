    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "pg": "^8.23.1",
    "sanitize-html": "^2.18.1",
    "swagger-jsdoc": "^6.3.0",
    "zod": "^4.6.7"
  },
  "overrides": {
